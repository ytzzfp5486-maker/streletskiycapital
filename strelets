<script>
  const shops = [
    { name: "Остров чистоты", category: "beauty", categoryLabel: "Красота и химия", description: "Косметика, парфюмерия и бытовая химия." },
    { name: "Мила", category: "beauty", categoryLabel: "Красота и химия", description: "Косметика, парфюмерия и бытовая химия." },
    { name: "Пинскдрев", category: "furniture", categoryLabel: "Мебель и техника", description: "Фирменный магазин мебели." },
    { name: "Савлуков-мебель", category: "furniture", categoryLabel: "Мебель и техника", description: "Мебель и товары для дома." },
    { name: "Паритетбанк", category: "services", categoryLabel: "Банки и связь", description: "Банковские услуги." },
    { name: "МТС", category: "services", categoryLabel: "Банки и связь", description: "Салон связи и мобильные услуги." },
    { name: "Коламбия", category: "clothes", categoryLabel: "Одежда и спорт", description: "Магазин одежды." },
    { name: "М-спорт", category: "clothes", categoryLabel: "Одежда и спорт", description: "Спортивные товары и экипировка." }
  ];

  const grid = document.getElementById('shopGrid');
  const search = document.getElementById('shopSearch');
  const filter = document.getElementById('shopFilter');
  const empty = document.getElementById('emptyResult');

  function renderShops() {
    const query = search.value.trim().toLowerCase();
    const category = filter.value;

    const result = shops.filter(shop => {
      const matchesQuery =
        shop.name.toLowerCase().includes(query) ||
        shop.description.toLowerCase().includes(query);
      const matchesCategory = category === 'all' || shop.category === category;
      return matchesQuery && matchesCategory;
    });

    grid.innerHTML = result.map(shop => `
      <article class="shop-card">
        <h3>${shop.name}</h3>
        <p>${shop.description}</p>
        <span class="shop-category">${shop.categoryLabel}</span>
      </article>
    `).join('');

    empty.style.display = result.length ? 'none' : 'block';
  }

  search.addEventListener('input', renderShops);
  filter.addEventListener('change', renderShops);
  renderShops();

  const burger = document.getElementById('burger');
  const menu = document.getElementById('menu');

  burger.addEventListener('click', () => menu.classList.toggle('open'));

  document.querySelectorAll('#menu a').forEach(link => {
    link.addEventListener('click', () => menu.classList.remove('open'));
  });

  document.getElementById('rentForm').addEventListener('submit', event => {
    event.preventDefault();

    const name = document.getElementById('name').value.trim();
    const phone = document.getElementById('phone').value.trim();
    const area = document.getElementById('area').value;
    const floor = document.getElementById('floor').value;
    const message = document.getElementById('message').value.trim();

    const text =
      `Заявка на аренду в ТЦ «Стрелецкий Капитал»%0A%0A` +
      `Имя: ${encodeURIComponent(name)}%0A` +
      `Телефон: ${encodeURIComponent(phone)}%0A` +
      `Площадь: ${encodeURIComponent(area)}%0A` +
      `Этаж: ${encodeURIComponent(floor)}%0A` +
      `Сообщение: ${encodeURIComponent(message || '—')}`;

    window.location.href =
      `mailto:info@arendastrelets.by?subject=${encodeURIComponent('Заявка на аренду помещения')}&body=${text}`;

    document.getElementById('successMessage').style.display = 'block';
    event.target.reset();
  });

  document.getElementById('year').textContent = new Date().getFullYear();
</script>

</body>
</html>
