  <style>
    :root {
      --bg: #f6f7f9;
      --surface: #ffffff;
      --ink: #0f172a;
      --muted: #5b6472;
      --line: #e5e8ee;
      --accent: #2563eb;
      --accent-dark: #1d4ed8;
      --accent-soft: #eaf1ff;
      --dark: #0b1220;
      --radius: 20px;
      --radius-sm: 14px;
      --shadow: 0 18px 45px rgba(15, 23, 42, .08);
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      font-family: "Manrope", "Segoe UI", system-ui, sans-serif;
      background: var(--bg);
      color: var(--ink);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    img { max-width: 100%; display: block; }

    a { color: inherit; }

    .container {
      width: min(1180px, calc(100% - 40px));
      margin-inline: auto;
    }

    .header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(246, 247, 249, .88);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--line);
    }

    .nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      padding: 14px 0;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
    }

    .brand-mark {
      display: grid;
      place-items: center;
      width: 46px;
      height: 46px;
      border-radius: 14px;
      background: linear-gradient(135deg, #2563eb, #7c3aed);
      color: #fff;
      font-weight: 800;
      font-size: 18px;
      letter-spacing: -.04em;
    }

    .brand-text {
      display: flex;
      flex-direction: column;
      line-height: 1.15;
    }

    .brand-text strong {
      font-size: 17px;
      letter-spacing: -.03em;
    }

    .brand-text span {
      color: var(--muted);
      font-size: 12px;
    }

    .menu {
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .menu a {
      padding: 10px 15px;
      border-radius: 999px;
      color: var(--muted);
      font-size: 15px;
      font-weight: 600;
      text-decoration: none;
      transition: .2s;
    }

    .menu a:hover,
    .menu a.active {
      color: var(--ink);
      background: #e9ecf2;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .phone-link {
      color: var(--ink);
      font-weight: 700;
      text-decoration: none;
      white-space: nowrap;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      padding: 13px 22px;
      border: 0;
      border-radius: 999px;
      background: var(--accent);
      color: #fff;
      font: inherit;
      font-size: 15px;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
      transition: .2s;
    }

    .btn:hover {
      background: var(--accent-dark);
      transform: translateY(-1px);
    }

    .btn-light {
      background: #fff;
      color: var(--ink);
      border: 1px solid var(--line);
    }

    .btn-light:hover {
      background: #f1f4f8;
      color: var(--accent);
    }

    .burger {
      display: none;
      width: 46px;
      height: 46px;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: #fff;
      font-size: 20px;
      cursor: pointer;
    }

    .hero {
      position: relative;
      overflow: hidden;
      padding: 80px 0 75px;
    }

    .hero::before {
      content: "";
      position: absolute;
      inset: auto -12% 45% auto;
      width: 640px;
      height: 640px;
      background: radial-gradient(circle, rgba(37, 99, 235, .17), transparent 65%);
      pointer-events: none;
    }

    .hero-grid {
      position: relative;
      display: grid;
      grid-template-columns: 1.05fr .95fr;
      gap: 45px;
      align-items: center;
    }

    .pill {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      padding: 9px 16px;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: #fff;
      color: var(--muted);
      font-size: 14px;
      font-weight: 600;
    }

    .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #22c55e;
      box-shadow: 0 0 0 4px rgba(34, 197, 94, .15);
    }

    h1 {
      margin: 24px 0 20px;
      font-size: clamp(40px, 6.4vw, 72px);
      line-height: 1.02;
      letter-spacing: -.05em;
      font-weight: 800;
    }

    .accent-text {
      background: linear-gradient(90deg, var(--accent), #7c3aed);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .lead {
      max-width: 610px;
      margin: 0 0 30px;
      color: var(--muted);
      font-size: 18px;
    }

    .hero-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .hero-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 26px;
      padding: 24px;
      box-shadow: var(--shadow);
    }

    .hero-image {
      width: 100%;
      height: 230px;
      object-fit: cover;
      border-radius: 18px;
      margin-bottom: 20px;
    }

    .hero-card-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      margin-bottom: 18px;
    }

    .hero-card-top strong { font-size: 17px; }

    .hero-card-top span {
      color: var(--muted);
      font-size: 13px;
    }

    .metric {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }

    .metric div {
      padding: 17px;
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
      background: #f8fafc;
    }

    .metric strong {
      display: block;
      font-size: 25px;
      letter-spacing: -.03em;
    }

    .metric span {
      color: var(--muted);
      font-size: 13px;
    }

    .section { padding: 85px 0; }

    .section-head {
      max-width: 780px;
      margin-bottom: 42px;
    }

    .eyebrow {
      color: var(--accent);
      font-size: 13px;
      font-weight: 800;
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    h2 {
      margin: 13px 0 15px;
      font-size: clamp(30px, 4.4vw, 46px);
      line-height: 1.1;
      letter-spacing: -.04em;
    }

    .section-head p {
      margin: 0;
      color: var(--muted);
      font-size: 17px;
    }

    .cards-3 {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 28px;
      box-shadow: var(--shadow);
      transition: .25s;
    }

    .card:hover {
      transform: translateY(-5px);
      border-color: #cdd6e4;
    }

    .icon {
      display: grid;
      place-items: center;
      width: 50px;
      height: 50px;
      margin-bottom: 20px;
      border-radius: 16px;
      background: var(--accent-soft);
      color: var(--accent);
      font-size: 23px;
    }

    .card h3 {
      margin: 0 0 10px;
      font-size: 20px;
      letter-spacing: -.02em;
    }

    .card p {
      margin: 0;
      color: var(--muted);
      font-size: 15px;
    }

    .dark-section {
      background: var(--dark);
      color: #fff;
    }

    .dark-section .section-head p,
    .dark-section .card p {
      color: #a7b0bf;
    }

    .dark-section .card {
      background: rgba(255, 255, 255, .05);
      border-color: rgba(255, 255, 255, .09);
      box-shadow: none;
    }

    .dark-section .icon {
      background: rgba(255, 255, 255, .1);
      color: #93c5fd;
    }

    .shop-tools {
      display: grid;
      grid-template-columns: 1fr 220px;
      gap: 12px;
      margin-bottom: 24px;
    }

    .shop-tools input,
    .shop-tools select {
      width: 100%;
      padding: 14px 16px;
      border: 1px solid rgba(255, 255, 255, .16);
      border-radius: 999px;
      background: rgba(255, 255, 255, .07);
      color: #fff;
      font: inherit;
      font-size: 15px;
      outline: none;
    }

    .shop-tools input::placeholder { color: #8b95a5; }

    .shop-tools input:focus,
    .shop-tools select:focus {
      border-color: #60a5fa;
      background: rgba(255, 255, 255, .1);
    }

    .shop-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }

    .shop-card {
      padding: 22px;
      background: rgba(255, 255, 255, .05);
      border: 1px solid rgba(255, 255, 255, .1);
      border-radius: var(--radius);
      transition: .2s;
    }

    .shop-card:hover {
      background: rgba(255, 255, 255, .09);
      transform: translateY(-3px);
    }

    .shop-card h3 {
      margin: 0 0 6px;
      font-size: 18px;
    }

    .shop-card p {
      margin: 0;
      color: #a7b0bf;
      font-size: 14px;
    }

    .shop-category {
      display: inline-block;
      margin-top: 13px;
      padding: 6px 12px;
      border-radius: 999px;
      background: rgba(37, 99, 235, .2);
      color: #bfdbfe;
      font-size: 12px;
      font-weight: 700;
    }

    .empty-result {
      display: none;
      padding: 35px;
      text-align: center;
      color: #a7b0bf;
      border: 1px dashed rgba(255, 255, 255, .2);
      border-radius: var(--radius);
    }

    .gallery {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
      margin-top: 34px;
    }

    .gallery-item {
      position: relative;
      border-radius: var(--radius);
      overflow: hidden;
      box-shadow: var(--shadow);
    }

    .gallery-item img {
      width: 100%;
      height: 250px;
      object-fit: cover;
      transition: .4s;
    }

    .gallery-item:hover img { transform: scale(1.05); }

    .gallery-caption {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      padding: 40px 20px 18px;
      color: #fff;
      font-weight: 700;
      background: linear-gradient(180deg, transparent, rgba(0, 0, 0, .72));
    }

    .rent-layout {
      display: grid;
      grid-template-columns: .9fr 1.1fr;
      gap: 18px;
      align-items: start;
    }

    .rent-info { display: grid; gap: 16px; }

    .rent-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 28px;
      box-shadow: var(--shadow);
    }

    .rent-card h3 {
      margin: 0 0 10px;
      font-size: 21px;
      letter-spacing: -.02em;
    }

    .rent-card p {
      margin: 0;
      color: var(--muted);
      font-size: 15px;
    }

    .rent-card ul {
      margin: 14px 0 0;
      padding-left: 20px;
      color: var(--muted);
      font-size: 15px;
    }

    .rent-card li + li { margin-top: 7px; }

    .tariffs { display: grid; gap: 14px; }

    .tariff {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 24px;
      box-shadow: var(--shadow);
    }

    .tariff-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      margin-bottom: 14px;
    }

    .tariff-head h3 {
      margin: 0;
      font-size: 19px;
      letter-spacing: -.02em;
    }

    .tariff-head span {
      color: var(--muted);
      font-size: 13px;
      font-weight: 600;
    }

    .tariff-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
    }

    .tariff-item {
      padding: 13px;
      border-radius: var(--radius-sm);
      background: #f8fafc;
      border: 1px solid var(--line);
      text-align: center;
    }

    .tariff-item span {
      display: block;
      color: var(--muted);
      font-size: 12px;
    }

    .tariff-item strong {
      font-size: 18px;
      letter-spacing: -.02em;
    }

    .rent-note {
      margin-top: 16px;
      padding: 18px 20px;
      border-left: 4px solid var(--accent);
      border-radius: 14px;
      background: var(--accent-soft);
      color: #243b5e;
      font-size: 15px;
    }

    .map-section {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
      align-items: stretch;
    }

    .map-frame {
      min-height: 430px;
      width: 100%;
      border: 0;
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }

    .contact-list { display: grid; gap: 12px; }

    .contact-item {
      display: flex;
      align-items: center;
      gap: 15px;
      padding: 18px 20px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
      box-shadow: var(--shadow);
      text-decoration: none;
      transition: .2s;
    }

    .contact-item:hover {
      transform: translateX(4px);
      border-color: #cdd6e4;
    }

    .contact-icon {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      flex: 0 0 auto;
      border-radius: 13px;
      background: var(--accent-soft);
      color: var(--accent);
      font-size: 19px;
    }

    .contact-item strong {
      display: block;
      font-size: 15px;
    }

    .contact-item span {
      color: var(--muted);
      font-size: 14px;
    }

    .form-section {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 30px;
      box-shadow: var(--shadow);
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 13px;
    }

    label {
      display: block;
      margin-bottom: 7px;
      color: var(--muted);
      font-size: 13px;
      font-weight: 700;
    }

    input,
    select,
    textarea {
      width: 100%;
      padding: 13px 15px;
      border: 1px solid var(--line);
      border-radius: 13px;
      background: #f8fafc;
      color: var(--ink);
      font: inherit;
      font-size: 15px;
      outline: none;
      transition: .2s;
    }

    input:focus,
    select:focus,
    textarea:focus {
      border-color: var(--accent);
      background: #fff;
      box-shadow: 0 0 0 4px rgba(37, 99, 235, .11);
    }

    textarea {
      min-height: 115px;
      resize: vertical;
    }

    .full { grid-column: 1 / -1; }

    .form-note {
      margin: 14px 0 0;
      color: var(--muted);
      font-size: 13px;
    }

    .success-message {
      display: none;
      margin-top: 15px;
      padding: 15px 18px;
      border-radius: 13px;
      background: #dcfce7;
      color: #166534;
      font-weight: 600;
    }

    .faq {
      display: grid;
      gap: 12px;
      max-width: 880px;
    }

    details {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
      padding: 18px 22px;
      box-shadow: var(--shadow);
    }

    summary {
      cursor: pointer;
      font-weight: 700;
      font-size: 16px;
      list-style: none;
    }

    summary::-webkit-details-marker { display: none; }

    summary::after {
      content: "+";
      float: right;
      color: var(--accent);
      font-size: 21px;
      font-weight: 700;
    }

    details[open] summary::after { content: "–"; }

    details p {
      margin: 12px 0 0;
      color: var(--muted);
      font-size: 15px;
    }

    .cta {
      background: linear-gradient(135deg, #101a2e, #1e293b);
      color: #fff;
      border-radius: 28px;
      padding: 55px 45px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 35px;
      box-shadow: var(--shadow);
    }

    .cta h2 {
      margin: 0 0 12px;
      color: #fff;
    }

    .cta p {
      margin: 0;
      color: #b7c1d1;
      max-width: 560px;
    }

    footer {
      padding: 38px 0;
      border-top: 1px solid var(--line);
      color: var(--muted);
      font-size: 14px;
    }

    .footer-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      flex-wrap: wrap;
    }

    .footer-links {
      display: flex;
      gap: 18px;
      flex-wrap: wrap;
    }

    .footer-links a {
      color: var(--muted);
      text-decoration: none;
    }

    .footer-links a:hover { color: var(--accent); }

    @media (max-width: 1020px) {
      .hero-grid,
      .rent-layout,
      .map-section { grid-template-columns: 1fr; }

      .cards-3,
      .shop-grid,
      .gallery { grid-template-columns: 1fr; }

      .shop-tools { grid-template-columns: 1fr; }

      .tariff-grid { grid-template-columns: repeat(2, 1fr); }

      .cta { flex-direction: column; align-items: flex-start; }
    }

    @media (max-width: 760px) {
      .menu {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        display: none;
        flex-direction: column;
        align-items: stretch;
        padding: 12px 20px 18px;
        background: rgba(246, 247, 249, .98);
        border-bottom: 1px solid var(--line);
      }

      .menu.open { display: flex; }

      .burger { display: block; }

      .header-actions .btn { display: none; }

      .hero { padding: 55px 0 45px; }

      .section { padding: 60px 0; }

      .form-grid { grid-template-columns: 1fr; }

      .form-grid .full { grid-column: auto; }

      .metric { grid-template-columns: 1fr; }

      .cta { padding: 35px 25px; }
    }
  </style>
</head>

<body id="top">

<header class="header">
  <div class="container nav">
    <a class="brand" href="#top">
      <span class="brand-mark">СК</span>
      <span class="brand-text">
        <strong>Стрелецкий Капитал</strong>
        <span>Торговый центр · Новополоцк</span>
      </span>
    </a>

    <nav class="menu" id="menu">
      <a href="#about">О центре</a>
      <a href="#shops">Магазины</a>
      <a href="#gallery">Фотогалерея</a>
      <a href="#rent">Аренда</a>
      <a href="#location">Как добраться</a>
